# UniOne API key — https://cp.unione.io/en/user/info/api
UNIONE_API_KEY=
# Region: eu (default) | us | global
UNIONE_REGION=eu
# Optional full base-URL override (must include the full path /en/transactional/api/v1; wins over region)
# UNIONE_BASE_URL=https://eu1.unione.io/en/transactional/api/v1
# Request timeout, seconds
UNIONE_TIMEOUT=30
